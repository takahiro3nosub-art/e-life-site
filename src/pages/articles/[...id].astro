---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);

  return articles.map((article) => ({
    params: { id: article.id.replace(/\.md$/, "") },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<"articles">;
}

const { article } = Astro.props;
const { Content } = await render(article);
const canonical = new URL(`/articles/${article.id.replace(/\.md$/, "")}/`, Astro.site).toString();
const dateFormatter = new Intl.DateTimeFormat("ja-JP", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: article.data.title,
    description: article.data.description,
    datePublished: article.data.publishedAt.toISOString(),
    dateModified: article.data.updatedAt.toISOString(),
    mainEntityOfPage: canonical,
    author: { "@type": "Organization", name: "E-Life" },
    publisher: { "@type": "Organization", name: "E-Life" },
    inLanguage: "ja",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "ホーム", item: "https://e-life.site/" },
      { "@type": "ListItem", position: 2, name: article.data.title, item: canonical },
    ],
  },
];
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  canonical={canonical}
  type="article"
  publishedAt={article.data.publishedAt}
  updatedAt={article.data.updatedAt}
  jsonLd={jsonLd}
>
  <header class="article-hero">
    <div class="site-shell">
      <nav class="breadcrumbs" aria-label="パンくずリスト">
        <a href="/">ホーム</a> / {article.data.category}
      </nav>
      <p class="eyebrow">{article.data.category}</p>
      <h1>{article.data.title}</h1>
      <p class="article-hero__description">{article.data.description}</p>
      <div class="article-meta">
        <time datetime={article.data.publishedAt.toISOString()}>
          公開：{dateFormatter.format(article.data.publishedAt)}
        </time>
        <time datetime={article.data.updatedAt.toISOString()}>
          更新：{dateFormatter.format(article.data.updatedAt)}
        </time>
      </div>
    </div>
  </header>

  <div class="site-shell article-wrap">
    <article class="article-body">
      <Content />
    </article>
    <aside class="article-side">
      <strong>この記事について</strong>
      2026年8月11日時点の公式情報と、実際の設定画面で確認した内容を分けて記載しています。料金や上限は導入時に公式ページで再確認してください。
    </aside>
  </div>
</BaseLayout>
