---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleFaq from "../../components/ArticleFaq.astro";
import ArticleGuide from "../../components/ArticleGuide.astro";
import CopyPrompt from "../../components/CopyPrompt.astro";
import RelatedArticles from "../../components/RelatedArticles.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import { SITE } from "../../site";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);

  return articles.map((article) => ({
    params: { id: article.id.replace(/\.md$/, "") },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<"articles">;
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const currentTags = new Set(article.data.tags);
const relatedArticles = (await getCollection("articles", ({ data }) => !data.draft))
  .filter((candidate) => candidate.id !== article.id)
  .map((candidate) => ({
    article: candidate,
    score:
      (candidate.data.category === article.data.category ? 1000 : 0) +
      candidate.data.tags.filter((tag) => currentTags.has(tag)).length * 100,
  }))
  .sort(
    (left, right) =>
      right.score - left.score ||
      right.article.data.publishedAt.valueOf() - left.article.data.publishedAt.valueOf(),
  )
  .slice(0, 2)
  .map(({ article: relatedArticle }) => relatedArticle);
const canonical = new URL(`/articles/${article.id.replace(/\.md$/, "")}/`, Astro.site).toString();
const image = article.data.image ?? SITE.defaultImage;
const articleImage = article.data.articleImage ?? {
  src: image,
  alt: article.data.imageAlt ?? "",
  width: 1200,
  height: 630,
};
const imageUrl = new URL(image, Astro.site).toString();
const dateFormatter = new Intl.DateTimeFormat("ja-JP", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "Asia/Tokyo",
});

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: article.data.title,
    description: article.data.description,
    datePublished: article.data.publishedAt.toISOString(),
    dateModified: article.data.updatedAt.toISOString(),
    mainEntityOfPage: canonical,
    image: [imageUrl],
    author: { "@type": "Person", name: "E-Life管理人", url: `${SITE.url}about/` },
    publisher: {
      "@type": "Organization",
      name: SITE.name,
      url: SITE.url,
      logo: { "@type": "ImageObject", url: new URL(SITE.logo, Astro.site).toString() },
    },
    inLanguage: "ja",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "ホーム", item: "https://e-life.site/" },
      { "@type": "ListItem", position: 2, name: article.data.title, item: canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: article.data.faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  canonical={canonical}
  type="article"
  publishedAt={article.data.publishedAt}
  updatedAt={article.data.updatedAt}
  jsonLd={jsonLd}
  image={image}
  imageAlt={article.data.imageAlt}
>
  <header class="article-hero">
    <div class="site-shell article-hero__inner">
      <img
        class="article-cover"
        src={articleImage.src}
        alt={articleImage.alt}
        width={articleImage.width}
        height={articleImage.height}
        loading="eager"
        fetchpriority="high"
      />
      <nav class="breadcrumbs" aria-label="パンくずリスト">
        <ol>
          <li><a href="/">ホーム</a></li>
          <li><a href="/#articles">記事一覧</a></li>
          <li aria-current="page">{article.data.title}</li>
        </ol>
      </nav>
      <div class="article-meta">
        <span class="article-meta__category">{article.data.category}</span>
        <time datetime={article.data.updatedAt.toISOString()}>
          {dateFormatter.format(article.data.updatedAt)}更新
        </time>
        <time datetime={article.data.factCheckedAt.toISOString()}>
          公式資料確認：{dateFormatter.format(article.data.factCheckedAt)}
        </time>
      </div>
      <h1>{article.data.title}</h1>
      <p class="article-hero__lead">{article.data.personalLead}</p>
      <div class="article-author" aria-label="この記事を書いた人">
        <span class="article-author__mark" aria-hidden="true">E</span>
        <span>
          <strong>E-Life管理人</strong>
          <small>40代でAIとCodexを試しています</small>
        </span>
      </div>
    </div>
  </header>

  <div class="site-shell article-wrap">
    <article class="article-body">
      <ArticleGuide
        quickAnswer={article.data.quickAnswer}
        headings={headings}
      />
      <Content />
      <CopyPrompt label={article.data.copyPrompt.label} text={article.data.copyPrompt.text} />
      <ArticleFaq items={article.data.faq} />
      <RelatedArticles
        articles={relatedArticles}
        currentCategory={article.data.category}
      />
      <ShareButtons title={article.data.title} url={canonical} />
    </article>
  </div>
</BaseLayout>
