---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleFaq from "../../components/ArticleFaq.astro";
import ArticleGuide from "../../components/ArticleGuide.astro";
import CopyPrompt from "../../components/CopyPrompt.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import { SITE } from "../../site";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);

  return articles.map((article) => ({
    params: { id: article.id.replace(/\.md$/, "") },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<"articles">;
}

const { article } = Astro.props;
const { Content } = await render(article);
const canonical = new URL(`/articles/${article.id.replace(/\.md$/, "")}/`, Astro.site).toString();
const image = article.data.image ?? SITE.defaultImage;
const imageUrl = new URL(image, Astro.site).toString();
const dateFormatter = new Intl.DateTimeFormat("ja-JP", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "Asia/Tokyo",
});

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: article.data.title,
    description: article.data.description,
    datePublished: article.data.publishedAt.toISOString(),
    dateModified: article.data.updatedAt.toISOString(),
    mainEntityOfPage: canonical,
    image: [imageUrl],
    author: { "@type": "Organization", name: SITE.name, url: `${SITE.url}about/` },
    publisher: {
      "@type": "Organization",
      name: SITE.name,
      url: SITE.url,
      logo: { "@type": "ImageObject", url: new URL(SITE.logo, Astro.site).toString() },
    },
    inLanguage: "ja",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "ホーム", item: "https://e-life.site/" },
      { "@type": "ListItem", position: 2, name: article.data.title, item: canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: article.data.faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  canonical={canonical}
  type="article"
  publishedAt={article.data.publishedAt}
  updatedAt={article.data.updatedAt}
  jsonLd={jsonLd}
  image={image}
  imageAlt={article.data.imageAlt}
>
  <header class="article-hero">
    <div class="site-shell">
      <nav class="breadcrumbs" aria-label="パンくずリスト">
        <a href="/">ホーム</a> / {article.data.category}
      </nav>
      <p class="eyebrow">{article.data.category}</p>
      <h1>{article.data.title}</h1>
      <p class="article-hero__description">{article.data.description}</p>
      <div class="article-meta">
        <time datetime={article.data.publishedAt.toISOString()}>
          公開：{dateFormatter.format(article.data.publishedAt)}
        </time>
        <time datetime={article.data.updatedAt.toISOString()}>
          更新：{dateFormatter.format(article.data.updatedAt)}
        </time>
        <time datetime={article.data.factCheckedAt.toISOString()}>
          根拠確認：{dateFormatter.format(article.data.factCheckedAt)}
        </time>
      </div>
      <img
        class="article-cover"
        src={image}
        alt={article.data.imageAlt ?? ""}
        width="1200"
        height="630"
        fetchpriority="high"
      />
    </div>
  </header>

  <div class="site-shell article-wrap">
    <article class="article-body">
      <ArticleGuide
        readerState={article.data.readerState}
        quickAnswer={article.data.quickAnswer}
        articleSteps={article.data.articleSteps}
      />
      <Content />
      <CopyPrompt label={article.data.copyPrompt.label} text={article.data.copyPrompt.text} />
      <ArticleFaq items={article.data.faq} />
      <ShareButtons title={article.data.title} url={canonical} />
    </article>
  </div>
</BaseLayout>
