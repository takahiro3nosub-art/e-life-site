---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../site";

const articles = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const websiteJsonLd = [
  {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: SITE.language,
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
    logo: new URL(SITE.logo, Astro.site).toString(),
    description: SITE.description,
  },
];
---

<BaseLayout title="E-Life" description={SITE.description} jsonLd={websiteJsonLd}>
  <section class="hero">
    <div class="site-shell hero__grid">
      <div>
        <p class="eyebrow">AI Agent Knowledge</p>
        <h1>
          <span class="hero__title-line">AIエージェント始めた</span>
          <span class="hero__title-line hero__title-line--accent">40代おじさんブログ</span>
        </h1>
        <p class="hero__lead">
          AIやCodexを仕事や生活に取り入れながら、実際に試したことをメモ代わりに残しています。
          設定方法や公式情報も、初心者目線で分かりやすく紹介します！
        </p>
      </div>
      <aside class="hero__note">
        <strong>このブログについて</strong>
        <p>
          40代でAIやCodexを使い始めた私が、迷ったことや実際に試した設定を記録しています。
        </p>
        <a class="hero__note-link" href="/about/">詳しく見る →</a>
      </aside>
    </div>
  </section>

  <section class="section" id="articles">
    <div class="site-shell">
      <div class="section__head">
        <div>
          <p class="eyebrow">Latest Articles</p>
          <h2>最近書いた記事</h2>
        </div>
      </div>
      <div class="article-grid">
        {
          articles.map((article) => (
            <a class="article-card" href={`/articles/${article.id}/`}>
              <div class="article-card__meta">
                <span class="article-card__category">{article.data.category}</span>
                <time datetime={article.data.publishedAt.toISOString()}>
                  {article.data.publishedAt.toLocaleDateString("ja-JP", { timeZone: "Asia/Tokyo" })}
                </time>
              </div>
              <h3>{article.data.title}</h3>
              <p>{article.data.description}</p>
              <span class="article-card__more">この記事を読む →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
