---
interface Props {
  quickAnswer: string;
  headings: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const { quickAnswer, headings } = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth === 2);
const answerParagraphs = quickAnswer
  .split(/\n+/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

<section class="article-guide" aria-labelledby="article-guide-title">
  <div class="article-guide__conclusion">
    <h2 id="article-guide-title">先に、私の結論</h2>
    <div class="article-guide__answers">
      {answerParagraphs.map((paragraph) => <p class="article-guide__answer">{paragraph}</p>)}
    </div>
  </div>

  {
    tocHeadings.length > 0 && (
      <nav class="article-toc" aria-labelledby="article-toc-title">
        <h3 id="article-toc-title">目次</h3>
        <ol>
          {tocHeadings.map((heading) => (
            <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ol>
      </nav>
    )
  }
</section>
