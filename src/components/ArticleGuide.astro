---
interface Props {
  readerState: string[];
  quickAnswer: string;
  articleSteps: string[];
}

const { readerState, quickAnswer, articleSteps } = Astro.props;
---

<section class="article-guide" aria-labelledby="article-guide-title">
  <h2 id="article-guide-title">先に、私の結論です</h2>
  <p class="article-guide__answer">{quickAnswer}</p>

  <div class="article-guide__details">
    <section aria-labelledby="reader-state-title">
      <h3 id="reader-state-title">こんな人に向けて書きました</h3>
      <ul>
        {readerState.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section aria-labelledby="article-steps-title">
      <h3 id="article-steps-title">この記事では、ここを順番に見ます</h3>
      <ol>
        {articleSteps.map((step) => <li>{step}</li>)}
      </ol>
    </section>
  </div>
</section>
