---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<section class="article-faq" aria-labelledby="article-faq-title">
  <h2 id="article-faq-title">ついでに気になったこと</h2>
  <div class="article-faq__items">
    {
      items.map((item) => (
        <section class="article-faq__item">
          <h3>{item.question}</h3>
          <p>{item.answer}</p>
        </section>
      ))
    }
  </div>
</section>
